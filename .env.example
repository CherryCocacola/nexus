# =============================================================================
# Project Nexus — 환경 변수 템플릿
# 이 파일을 .env로 복사한 후 실제 값을 입력한다.
# 모든 변수는 NEXUS_ 접두사를 사용한다.
# 아래 예시값은 현행 분리형 배포(웹·DB=192.168.21.112 / GPU 백엔드=B200) 기준이다.
# =============================================================================

# GPU 서버 (Machine B) — 추론 vLLM(A.X-4.0). 분리형 배포에서 112 웹이
# B200 vLLM(:8001)을 112 상주 SSH 터널 로컬포트(18001)로 호출한다.
NEXUS_GPU_SERVER_URL=http://127.0.0.1:18001

# Redis (단기 메모리) — 112 이관
NEXUS_REDIS__HOST=192.168.21.112
NEXUS_REDIS__PORT=6340
NEXUS_REDIS__PASSWORD=

# PostgreSQL (장기 메모리 + pgvector) — 112 이관
NEXUS_POSTGRESQL__HOST=192.168.21.112
NEXUS_POSTGRESQL__PORT=5440
NEXUS_POSTGRESQL__DATABASE=idino_ai
NEXUS_POSTGRESQL__USER=idino_user
NEXUS_POSTGRESQL__PASSWORD=

# 모델 — primary=A.X-4.0(현행 배포 기본). 세그먼트별 대체는 config/*.yaml에서.
NEXUS_MODEL__PRIMARY_MODEL=ax-4.0
NEXUS_MODEL__AUXILIARY_MODEL=exaone-7.8b

# 운영
NEXUS_LOG_LEVEL=INFO
NEXUS_DEBUG=false
NEXUS_AIR_GAP_MODE=true
