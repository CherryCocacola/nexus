# B200 GPU 백엔드 운영 자격증명 — 이 파일을 /NHNHOME/nexus/.env 로 복사해 값을 채운다.
#
#   cp env.example /NHNHOME/nexus/.env
#   chmod 600 /NHNHOME/nexus/.env      ← 반드시. 기본 umask 로 두면 644 가 된다.
#
# start_all.sh 가 `set -a; . .env; set +a` 로 읽어 자식 tmux 세션까지 물려준다.
# 값에 따옴표를 두르지 않아도 된다 — `#` 이 단어 중간에 있으면 주석이 아니다.
# 다만 값에 공백이 있으면 반드시 따옴표로 감싸라.

NEXUS_PG_PASSWORD=
NEXUS_REDIS_PASSWORD=
